# Copiez ce fichier vers .env puis collez les identifiants OAuth de votre application PISTE.
PISTE_ENV=production
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
# Nombre maximal d'articles cibles vérifiés en une analyse (1 à 500)
MAX_REFERENCES=100
# Par défaut le serveur écoute uniquement sur votre ordinateur
HOST=127.0.0.1
PORT=8765
