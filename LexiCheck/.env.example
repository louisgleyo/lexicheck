# A copier en .env pour une utilisation locale. Ne jamais pousser .env sur GitHub.
PISTE_ENV=production
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
HOST=127.0.0.1
PORT=8765
MAX_REFERENCES=100
JOB_BATCH_MAX=40
BULK_REF_LIMIT=25
# Recommande pour protege les quotas PISTE quand le site est public.
APP_ACCESS_PASSWORD=
# Mentions legales de l'editeur a renseigner avant publication publique.
SITE_EDITOR_NAME=
SITE_EDITOR_EMAIL=
SITE_EDITOR_ADDRESS=
SITE_EDITOR_PHONE=
# Recherche de concordances bornée pour limiter la consommation du quota PISTE.
CONCORDANCE_MAX_CALLS=9
CONCORDANCE_MAX_HOPS=3
CONCORDANCE_VERSION_PROBES=5
